diff --git a/src/viewers/board/viewer.ts b/src/viewers/board/viewer.ts
index 43cbe73..db96c56 100644
--- a/src/viewers/board/viewer.ts
+++ b/src/viewers/board/viewer.ts
@@ -154,7 +154,22 @@ export class BoardViewer extends DocumentViewer<
 
     zoom_to_board() {
         const edge_cuts = this.layers.by_name(LayerNames.edge_cuts)!;
-        const board_bbox = edge_cuts.bbox;
