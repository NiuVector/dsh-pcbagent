+        const edge_bbox = edge_cuts.bbox;
+        const board_bbox = edge_bbox.valid ? edge_bbox : BBox.combine(
+            [...this.layers.in_order()]
+                .filter(layer => layer.visible && layer.name !== LayerNames.drawing_sheet && layer.name !== LayerNames.grid)
+                .map(layer => layer.bbox),
+        );
+        if (!board_bbox.valid) {
+            super.zoom_to_page();
+            return;
+        }
+        this.viewport.camera.bbox = board_bbox.grow(Math.max(board_bbox.w, board_bbox.h) * 0.08 + 1);
+        this.layers.by_name(LayerNames.drawing_sheet)!.visible = false;
+        this.draw();
+    }
+
+    override zoom_to_page() {
+        this.zoom_to_board();
     }
 }
